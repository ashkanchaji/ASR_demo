# Copy to .env and restart after changes. All model paths must already exist.
# language=auto uses a stock detector, then the matching transcription slot.
# Browser model selections change the slot until another selection or restart.

# CPU default; CUDA is optional. Use float16 with cuda, int8 with cpu.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_CPU_THREADS=0
WHISPER_BEAM_SIZE=5

# Model discovery and the four resident roles.
WHISPER_MODELS_DIR=./models
# ./scripts/convert_khosravi_large.sh
WHISPER_FA_MODEL=./models/whisper-large-v3-persian-khosravi-ct2
# ./scripts/fetch_model.sh small.en
WHISPER_EN_MODEL=./models/faster-whisper-small.en
# Stock multilingual detector. Persian-only fine-tunes bias language ID.
# ./scripts/convert_large_turbo.sh
WHISPER_DETECT_MODEL=./models/whisper-large-v3-turbo-ct2
# Stock multilingual wake probe. ./scripts/fetch_model.sh tiny
WHISPER_WAKE_MODEL=./models/faster-whisper-tiny

# Persian share of fa+en probability mass required to route to Persian.
# 0.5 selects the larger probability, with ties routed to Persian.
WHISPER_FA_MIN_PROB=0.5

# Decoding hints and Persian-only spelling correction. Disabling correction
# still normalizes Persian letters, diacritics, and whitespace.
WHISPER_HOTWORDS_FILE=./config/hotwords.json
SPELL_CORRECTION_ENABLED=true
SPELL_CORRECTION_THRESHOLD=0.85
SPELL_CORRECTION_LEXICON=./config/persian-words.txt

# Debug recording only. No rotation or cap; recordings are excluded from Git.
WHISPER_SAVE_CLIPS=0
WHISPER_SAMPLES_DIR=./eval/samples

# Set the launcher's port in the shell: PORT=9000 ./run.sh
# Docker defaults to 8000; override with docker run -e PORT=9000 ...
