# Language is picked per request, not here -- language=auto races the two
# models below and keeps whichever is more confident. Which model fills each
# language slot IS set here (defaults below) but is also swappable at runtime
# from the frontend (a select per language, filled from GET /health) -- that
# change is sticky, it stays the active model for the slot until changed again.
# See CLAUDE.md for the full model list (vetted vs. comparison-only) and
# scripts/convert_*.sh / fetch_*.sh to build/fetch each one.

# cpu or cuda. Falls back to CPU int8 with a warning if CUDA is set but cannot
# be used. Both models below are resident at once -- see CLAUDE.md's low-VRAM
# note -- so cuda is what keeps the default pair fast.
WHISPER_DEVICE=cpu

# Directory _discover_models() scans for CT2 model directories, i.e. what
# either slot's select may be swapped to. model.bin is what makes a directory
# count; a half-finished conversion is not offered.
WHISPER_MODELS_DIR=./models

# Persian slot's default model. large-v3 fine-tune -- heavier than the old
# small-persian default, see CLAUDE.md's WER/vetting note; picked anyway for
# accuracy. Converted with: ./scripts/convert_khosravi_large.sh
WHISPER_FA_MODEL=./models/whisper-large-v3-persian-khosravi-ct2

# English slot's default model. Official Systran build, English-only by
# construction (no detect_language() at all), pinned resident alongside the
# Persian one -- see _active in main.py. Fetched with:
#     ./scripts/fetch_model.sh small.en
WHISPER_EN_MODEL=./models/faster-whisper-small.en

# The model that decides fa-vs-en when language=auto. Must be a STOCK model:
# every Persian fine-tune here has a retrained language-ID head that answers fa
# unconditionally, which is what made English come back as Persian-script
# transliteration ("show me the settings page" -> "شو می ده ستینگ پیج").
# Measured with scripts/evaluate_model.py --detect, fa share of fa+en mass:
#
#   detector                      fa clip   en clip
#   whisper-small-persian          1.000     1.000   <- cannot separate at all
#   khosravi large-v3 fa           1.000     0.881
#   amirmohseni large-v3 fa        1.000     0.844
#   whisper-large-v3-turbo         0.930     0.000   <- the default, for this reason
#
# It is a third resident model and a large one, so it costs VRAM. Re-measure
# with --detect before swapping it for anything cheaper. An English-only model
# here is rejected at boot: it has no detect_language().
WHISPER_DETECT_MODEL=./models/whisper-large-v3-turbo-ct2

# A fourth resident model, but a tiny/cheap one: checks always-on clips for
# the wake word before any of the models above ever run. Ambient noise and
# false triggers get rejected fast instead of paying for a full detect+
# transcribe pass every time the browser's VAD fires. Stock and multilingual
# for the same reason as WHISPER_DETECT_MODEL -- the wake phrase has Persian
# spellings too. Fetch with: ./scripts/fetch_model.sh tiny
WHISPER_WAKE_MODEL=./models/faster-whisper-tiny

# Share of the fa+en probability mass that must be fa before a clip routes to
# Persian. 0.5 is exactly argmax (ties to fa). Decided on the share rather than
# raw P(fa) so the number keeps its meaning if you swap detectors. This trims a
# detector that is already close; it cannot repair a biased one (a saturated
# fine-tune reads 1.000 on both languages). The per-request "[detect]" log line
# gives the real numbers, and --detect tabulates them across clips.
WHISPER_FA_MIN_PROB=0.5

# Debug: keep every uploaded clip in eval/samples/ so the eval harness has real
# audio to score. Off by default. No rotation and no cap -- turn it on, record
# what you need, turn it off. This repo ships no clips, which is exactly why
# the fa/en routing bug above went unmeasured twice.
#WHISPER_SAVE_CLIPS=1

# int8 on CPU, float16 on GPU. Left unset it follows WHISPER_DEVICE.
WHISPER_COMPUTE=int8

# CPU cores CTranslate2 may use. 0 means auto-detect (all of them). Set it when
# the box is shared, or to measure how throughput scales with cores.
WHISPER_CPU_THREADS=0

# Decoding beam width. 5 is faster-whisper's default; 1 is greedy decoding, which
# is markedly cheaper on CPU. See the model table in the README for the tradeoff.
WHISPER_BEAM_SIZE=5

# JSON file of {"fa": [...], "en": [...]} terms to bias decoding toward -- app
# page/feature names the model otherwise mishears. Missing file = no biasing,
# not a startup error.
WHISPER_HOTWORDS_FILE=./config/hotwords.json

# Persian spell correction, applied to the transcript after decoding. English
# output is never touched. Whisper misspells Persian homophones predictably --
# ز/ذ/ض/ظ are one sound, so "گزارش" comes back as "گذارش" -- and the fix is a
# phonetic-bucket match against config/hotwords.json.
#
# Setting this to false disables the correction only. Orthographic normalization
# (Arabic ي/ك rewritten to Persian, diacritics dropped, half-spaces tidied) always
# runs on Persian output, because it is correct regardless.
SPELL_CORRECTION_ENABLED=true

# Similarity a phonetic form must reach before a word is rewritten. Measured on
# eval/spell_cases.json: 0.80-0.85 fixes 16/16 known misspellings with 0 false
# positives, 0.90 loses the "سفه" -> "صفحه" case (it scores 0.857), and 0.75 and
# below starts rewriting correct words. Re-measure after editing the hotwords:
#     .venv/bin/python scripts/evaluate_model.py --spell --threshold 0.9
SPELL_CORRECTION_THRESHOLD=0.85

# Optional newline-delimited Persian word list, widening coverage beyond the
# hotwords. Words in it are treated as known-good (never corrected) and as
# correction targets of last resort -- hotwords always win. No file ships here:
# a general lexicon is a large artifact and this service never downloads
# anything. Missing file = hotwords only, which is the vocabulary that matters.
SPELL_CORRECTION_LEXICON=./config/persian-words.txt

# Port for run.sh and the container.
PORT=8000

# Optional: push each transcript to a paired PC's /api/external/messages (e.g.
# a nav-resolver box on the same Wi-Fi network). Empty host disables the push
# outright -- no network call is attempted, and the GUI still shows the
# transcript either way; a failed push only adds an error alongside it.
EXTERNAL_API_HOST=
EXTERNAL_API_PORT=8000

# Seconds to wait for that PC's response. It resolves through an LLM, so give
# it real headroom -- too short reads as "unreachable" when it was just slow.
EXTERNAL_API_TIMEOUT=30
